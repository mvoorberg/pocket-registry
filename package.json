{
  "name": "pocket-registry",
  "version": "3.0.0",
  "description": "A simple JavaScript registry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "deploy": "np",
    "test": "cross-env NODE_ENV=test c8 mocha",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvoorberg/pocket-registry.git"
  },
  "keywords": [
    "registry",
    "simple"
  ],
  "author": "Mark Voorberg <mark@binaryops.ca>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mvoorberg/pocket-registry/issues"
  },
  "homepage": "https://github.com/mvoorberg/pocket-registry#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "chai": "^4.3.7",
    "cross-env": "^6.0.3",
    "lodash": "^4.18.1",
    "mocha": "^12.0.3",
    "np": "^12.1.1",
    "shelljs": "^0.8.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ]
}
